<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="498.0" prefWidth="678.0"
      spacing="20.0"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>

   <BorderPane prefHeight="458.0" prefWidth="638.0">

      <top>
         <VBox alignment="CENTER" prefHeight="80.0">
            <children>
               <Label text="Edit Screening" styleClass="title-label"/>
            </children>
         </VBox>
      </top>

      <center>
         <VBox alignment="CENTER" spacing="25.0">
            <children>
               <HBox alignment="CENTER" spacing="20.0">
                  <children>
                     <Label text="Screening Times"/>
                     <ListView fx:id="screeningTimesListView"
                               prefHeight="150.0"
                               prefWidth="300.0"/>
                  </children>
               </HBox>

               <HBox alignment="CENTER" spacing="20.0">
                  <children>
                     <Label text="Movies"/>
                     <ListView fx:id="moviesListView"
                               prefHeight="150.0"
                               prefWidth="300.0"/>
                  </children>
               </HBox>
            </children>
         </VBox>
      </center>

      <bottom>
         <VBox alignment="CENTER" prefHeight="70.0">
            <children>
               <HBox alignment="CENTER" spacing="40.0">
                  <children>
                     <Button fx:id="saveButton"
                             mnemonicParsing="false"
                             text="Save"/>

                     <Button fx:id="backButton"
                             mnemonicParsing="false"
                             text="Back"/>
                  </children>
               </HBox>
            </children>
         </VBox>
      </bottom>

   </BorderPane>
</VBox>
