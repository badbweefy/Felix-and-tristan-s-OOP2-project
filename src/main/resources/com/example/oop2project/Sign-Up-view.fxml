<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="400.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>

   <BorderPane prefHeight="360.0" prefWidth="560.0">

      <top>
         <VBox alignment="CENTER" prefHeight="80.0">
            <children>
               <Label text="Sign Up" styleClass="title-label"/>
            </children>
         </VBox>
      </top>

      <center>
         <VBox alignment="CENTER" spacing="10.0">
            <children>
               <VBox spacing="5.0" maxWidth="220.0">
                  <children>
                     <Label text="Username"/>
                     <TextField promptText="Enter username"/>

                     <Label text="Password"/>
                     <TextField promptText="Enter password"/>
                  </children>
               </VBox>
            </children>
         </VBox>
      </center>

      <bottom>
         <VBox alignment="CENTER" prefHeight="100.0">
            <children>
               <Button mnemonicParsing="false" text="Create Account"/>
            </children>
         </VBox>
      </bottom>

   </BorderPane>
</VBox>
