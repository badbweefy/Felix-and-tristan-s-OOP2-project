<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0"
      spacing="20.0"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>

   <BorderPane prefHeight="360.0" prefWidth="560.0">

      <top>
         <VBox alignment="CENTER" prefHeight="80.0">
            <children>
               <Label text="Login" styleClass="title-label"/>
            </children>
         </VBox>
      </top>

      <center>
         <VBox alignment="CENTER" spacing="10.0">
            <children>
               <VBox spacing="5.0" maxWidth="220.0">
                  <children>
                     <Label text="Username"/>
                     <TextField promptText="Enter username"/>

                     <Label text="Password"/>
                     <TextField promptText="Enter password"/>
                  </children>
               </VBox>

               <Button mnemonicParsing="false" text="Continue"/>
            </children>
         </VBox>
      </center>

      <bottom>
         <VBox alignment="CENTER" spacing="10.0" prefHeight="100.0">
            <children>
               <Label text="Don't have an account?"/>

               <HBox alignment="CENTER" spacing="20.0">
                  <children>
                     <Button mnemonicParsing="false" text="Sign Up"/>
                     <Button mnemonicParsing="false" text="Manager"/>
                  </children>
               </HBox>
            </children>
         </VBox>
      </bottom>

   </BorderPane>
</VBox>