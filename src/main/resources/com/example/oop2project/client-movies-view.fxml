<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0"
      spacing="20.0"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>

   <BorderPane prefHeight="360.0" prefWidth="560.0">

      <top>
         <VBox alignment="CENTER" prefHeight="80.0">
            <children>
               <Label text="Movies Playing" styleClass="title-label"/>
            </children>
         </VBox>
      </top>

      <center>
         <VBox alignment="CENTER" spacing="15.0">
            <children>
               <Label text="Current Showtimes"/>

               <ListView prefHeight="175.0" prefWidth="300.0"/>
            </children>
         </VBox>
      </center>

      <bottom>
         <VBox alignment="CENTER" spacing="15.0" prefHeight="100.0">
            <children>
               <HBox alignment="CENTER" spacing="30.0">
                  <children>
                     <Button mnemonicParsing="false" text="View Details"/>
                     <Button mnemonicParsing="false" text="Add to Cart"/>
                  </children>
               </HBox>

               <Button mnemonicParsing="false" text="Back"/>
            </children>
         </VBox>
      </bottom>

   </BorderPane>
</VBox>