<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="557.0" prefWidth="418.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo2.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <BorderPane prefHeight="493.0" prefWidth="378.0">
      <top>
         <VBox alignment="CENTER" prefHeight="107.0" prefWidth="378.0" BorderPane.alignment="CENTER">
            <children>
               <Label text="Movies List">
                  <font>
                     <Font name="System Bold" size="31.0" />
                  </font>
               </Label>
            </children></VBox>
      </top>
      <center>
         <HBox alignment="CENTER" prefHeight="244.0" prefWidth="378.0" BorderPane.alignment="CENTER">
            <children>
               <ListView prefHeight="122.0" prefWidth="200.0" />
            </children>
         </HBox>
      </center>
      <bottom>
         <VBox alignment="CENTER" prefHeight="151.0" prefWidth="378.0" BorderPane.alignment="CENTER">
            <children>
               <HBox alignment="CENTER" prefHeight="103.0" prefWidth="378.0">
                  <children>
                     <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="90.0" text="Add Movie">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin>
                     </Button>
                     <Button mnemonicParsing="false" prefHeight="38.0" prefWidth="76.0" text="Edit Movie">
                        <HBox.margin>
                           <Insets left="25.0" right="25.0" />
                        </HBox.margin>
                     </Button>
                      <Button onAction="#onHelloButtonClick" prefHeight="38.0" prefWidth="90.0" text="Delete Movie" />
                  </children>
               </HBox>
               <Button mnemonicParsing="false" text="Back" />
            </children>
         </VBox>
      </bottom>
   </BorderPane>

    <Label fx:id="welcomeText" />
</VBox>
