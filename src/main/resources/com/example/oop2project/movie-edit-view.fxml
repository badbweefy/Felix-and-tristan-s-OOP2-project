<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="557.0" prefWidth="418.0"
      spacing="20.0"
      stylesheets="@styles.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
   </padding>

   <BorderPane prefHeight="493.0" prefWidth="378.0">

      <top>
         <VBox alignment="CENTER" prefHeight="89.0">
            <children>
               <Label text="Movies List" styleClass="title-label"/>
            </children>
         </VBox>
      </top>

      <center>
         <VBox alignment="CENTER" spacing="15.0">
            <children>
               <ListView prefHeight="200.0" prefWidth="200.0"/>

               <HBox alignment="CENTER" spacing="20.0">
                  <children>
                     <VBox alignment="CENTER" spacing="5.0">
                        <Label text="Movie Name"/>
                        <TextField prefWidth="109.0"/>
                     </VBox>

                     <VBox alignment="CENTER" spacing="5.0">
                        <Label text="Runtime"/>
                        <TextField prefWidth="79.0"/>
                     </VBox>
                  </children>
               </HBox>
            </children>
         </VBox>
      </center>

      <bottom>
         <VBox alignment="CENTER" spacing="15.0">
            <children>
               <HBox alignment="CENTER" spacing="20.0">
                  <children>
                     <Button mnemonicParsing="false"
                             prefWidth="90.0"
                             text="Add Movie"/>

                     <Button mnemonicParsing="false"
                             prefWidth="90.0"
                             text="Edit Movie"/>

                     <Button prefWidth="90.0"
                             text="Delete Movie"/>
                  </children>
               </HBox>

               <Button mnemonicParsing="false" text="Back"/>
            </children>
         </VBox>
      </bottom>

   </BorderPane>

   <Label fx:id="welcomeText"/>
</VBox>
